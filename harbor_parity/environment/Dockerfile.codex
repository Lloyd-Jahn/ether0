# Parity image used on BOTH sides of the ether0-benchmark parity experiment.
#
# It is the adapter's task image (environment/Dockerfile) with the Codex agent
# preinstalled, using exactly the steps Harbor's installed Codex agent runs at agent
# setup (system deps via apt, nvm + Node 22, npm-installed @openai/codex, symlinks).
# Harbor skips its own install when the requested Codex version is already present,
# and the original-side runner does the same, so both sides start from an identical
# agent environment without reinstalling Node.js for every trial.
ARG BASE_IMAGE=ether0-parity-env:latest
FROM ${BASE_IMAGE}

ARG CODEX_VERSION=0.166.0
# Optional Debian mirror (e.g. https://mirror.sjtu.edu.cn) used only while installing;
# the image's original apt sources are restored afterwards. Empty = deb.debian.org.
ARG APT_MIRROR=

# Harbor: ensure_system_dependencies(curl, bash, nodejs, npm, ripgrep) -> apt-get
# Differences from Harbor's runtime command, neither of which affects the agent:
# - Acquire::Retries makes downloads robust to transient network errors (same packages).
# - --no-install-recommends skips recommended-only packages such as dbus, whose
#   post-install chown to the messagebus group fails under rootless user-namespace
#   runtimes. Codex runs on the nvm-installed Node 22 below; the apt packages only
#   satisfy Harbor's dependency check.
RUN DEBIAN_FRONTEND=noninteractive bash -c 'set -e; S=/etc/apt/sources.list.d/debian.sources; \
    if [ -n "$APT_MIRROR" ]; then cp "$S" /tmp/debian.sources.orig; \
      sed -i "s#http://deb.debian.org#${APT_MIRROR}#g" "$S"; fi; \
    apt-get -o Acquire::Retries=5 update && \
    apt-get -o Acquire::Retries=5 install -y --no-install-recommends nodejs npm ripgrep; \
    if [ -n "$APT_MIRROR" ]; then mv /tmp/debian.sources.orig "$S"; fi'

# Harbor: Codex install (nvm + Node 22 + npm install -g @openai/codex@<version>)
RUN NVM_NODEJS_ORG_MIRROR=https://nodejs.org/dist bash -c 'set -euo pipefail; \
    curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.2/install.sh | bash && \
    export NVM_DIR="$HOME/.nvm" && \
    \. "$NVM_DIR/nvm.sh" || true && \
    command -v nvm &>/dev/null || { echo "Error: NVM failed to load" >&2; exit 1; } && \
    nvm install 22 && nvm alias default 22 && npm -v && \
    npm install -g @openai/codex@${CODEX_VERSION} && \
    codex --version'

# Harbor: symlink node/codex into /usr/local/bin
RUN bash -c '. "$HOME/.nvm/nvm.sh"; for bin in node codex; do \
      BIN_PATH="$(which "$bin" 2>/dev/null || true)"; \
      if [ -n "$BIN_PATH" ] && [ "$BIN_PATH" != "/usr/local/bin/$bin" ]; then \
        ln -sf "$BIN_PATH" "/usr/local/bin/$bin"; \
      fi; \
    done'
